{
    email ${acme_email}
    acme_ca https://acme.zerossl.com/v2/DV90
    crowdsec {
        api_url http://crowdsec:8080
        api_key ${crowdsec_api_key}
    }
    order rate_limit before basicauth
}

(rate_limit) {
    rate_limit {
        zone dynamic {
            key {remote_host}
            events 1000
            window 10s
        }
    }
}

(basic_auth) {
    basicauth {
        ${basic_auth_user} ${basic_auth_hash}
    }
}

frp.${domain_name} {
    import rate_limit
    route {
        crowdsec
        reverse_proxy frps:7500
    }
    log {
        output file /var/log/caddy/access.log
    }
}

%{ for subdomain in subdomains_with_basic_auth ~}
${subdomain}.${domain_name} {
    import rate_limit
    import basic_auth
    route {
        crowdsec
        reverse_proxy frps:8080
    }
    log {
        output file /var/log/caddy/access.log
    }
}

%{ endfor ~}
%{ for subdomain in subdomains_without_basic_auth ~}
${subdomain}.${domain_name} {
    import rate_limit
    route {
        crowdsec
        reverse_proxy frps:8080
    }
    log {
        output file /var/log/caddy/access.log
    }
}

%{ endfor ~}
