---
name: pangolin

services:
  pangolin:
    # https://github.com/fosrl/pangolin/releases
    image: docker.io/fosrl/pangolin:postgresql-1.16.2
    container_name: pangolin
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./config:/app/config
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3001/api/v1/"]
      interval: "10s"
      timeout: "10s"
      retries: 15

  postgres:
    image: docker.io/postgres:17
    container_name: postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER=${pangolin_pg_user}
      - POSTGRES_PASSWORD=${pangolin_pg_password}
      - POSTGRES_DB=pangolin
    volumes:
      - ./config/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${pangolin_pg_user}"]
      interval: 10s
      timeout: 5s
      retries: 5

  gerbil:
    # https://github.com/fosrl/gerbil/releases
    image: docker.io/fosrl/gerbil:1.3.0
    container_name: gerbil
    restart: unless-stopped
    depends_on:
      pangolin:
        condition: service_healthy
    command:
      - --reachableAt=http://gerbil:3004
      - --generateAndSaveKeyTo=/var/config/key
      - --remoteConfig=http://pangolin:3001/api/v1/
    volumes:
      - ./config/:/var/config
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    ports:
      - 51820:51820/udp
      - 21820:21820/udp
      - 443:443
      - 80:80

  crowdsec:
    # https://github.com/crowdsecurity/crowdsec/releases
    image: docker.io/crowdsecurity/crowdsec:v1.7.6
    container_name: crowdsec
    restart: unless-stopped
    environment:
      GID: "1000"
      COLLECTIONS: "crowdsecurity/traefik crowdsecurity/appsec-virtual-patching crowdsecurity/appsec-generic-rules crowdsecurity/linux"
      PARSERS: "crowdsecurity/whitelists"
      BOUNCER_KEY_traefik: "${crowdsec_bouncer_key}"
      BOUNCER_KEY_firewall: "${crowdsec_firewall_bouncer_key}"
    healthcheck:
      test: ["CMD", "cscli", "lapi", "status"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    volumes:
      - ./config/crowdsec:/etc/crowdsec
      - ./config/crowdsec/db:/var/lib/crowdsec/data
      - ./config/traefik/logs:/var/log/traefik:ro
      - /var/log/auth.log:/var/log/auth.log:ro
      - /var/log/syslog:/var/log/syslog:ro
    ports:
      - "127.0.0.1:8080:8080"

  traefik:
    # https://github.com/traefik/traefik/releases
    image: docker.io/traefik:v3.6.10
    container_name: traefik
    restart: unless-stopped
    network_mode: service:gerbil
    depends_on:
      pangolin:
        condition: service_healthy
      crowdsec:
        condition: service_healthy
    command:
      - --configFile=/etc/traefik/traefik_config.yml
    environment:
      - SCW_ACCESS_KEY=${scaleway_access_key}
      - SCW_SECRET_KEY=${scaleway_secret_key}
    volumes:
      - ./config/traefik:/etc/traefik:ro
      - ./config/letsencrypt:/letsencrypt
      - ./config/traefik/logs:/var/log/traefik

networks:
  default:
    driver: bridge
    name: pangolin
